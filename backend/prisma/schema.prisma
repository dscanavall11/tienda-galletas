// Modelo de datos normalizado a 3FN para la demo de la tienda de galletas.
// Nota académica sobre tipos: los montos usan Float (no Decimal) porque el
// conector de SQLite en Prisma no soporta Decimal de forma confiable; en un
// motor real (Postgres/MySQL) se preferiría Decimal o enteros en centavos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Evita repetir el nombre de categoría como texto libre en cada galleta
// (elimina una dependencia transitiva Galleta -> nombreCategoria -> ... => 3FN).
model Categoria {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  galletas Galleta[]

  @@map("categorias")
}

model Galleta {
  id           Int                  @id @default(autoincrement())
  nombre       String
  descripcion  String?
  fotoUrl      String
  precio       Float
  stock        Int                  @default(0)
  activa       Boolean              @default(true)
  categoriaId  Int
  categoria    Categoria            @relation(fields: [categoriaId], references: [id])
  detalles     DetallePedido[]
  ingredientes GalletaIngrediente[]

  @@map("galletas")
}

// Cada ingrediente se guarda una sola vez. Una lista "harina, mantequilla,
// huevo" dentro de un campo de la galleta sería un atributo multivalor (rompe
// la 1FN) y repetiría el mismo texto en muchas filas. `alergeno` es un valor
// simple (un ingrediente declara a lo sumo uno), por eso no necesita tabla propia.
model Ingrediente {
  id       Int                  @id @default(autoincrement())
  nombre   String               @unique
  alergeno String?
  galletas GalletaIngrediente[]

  @@map("ingredientes")
}

// Entidad asociativa que resuelve la relación N:M entre Galleta e Ingrediente
// (la receta). `posicion` es un atributo de la relación, no de ninguno de los
// dos lados: el orden en que aparece el ingrediente en esa galleta (de mayor a
// menor cantidad). Al borrar la galleta se borra su receta.
model GalletaIngrediente {
  galletaId     Int
  galleta       Galleta     @relation(fields: [galletaId], references: [id], onDelete: Cascade)
  ingredienteId Int
  ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id])
  posicion      Int

  @@id([galletaId, ingredienteId])
  @@map("galleta_ingrediente")
}

// Los datos del cliente se capturan una sola vez y se reutilizan por email;
// evita duplicar nombre/dirección/teléfono en cada pedido.
model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  telefono  String?
  direccion String?
  documento String?
  pedidos   Pedido[]
  cuenta    Cuenta?

  @@map("clientes")
}

// Credenciales de acceso del cliente, separadas de sus datos de perfil
// (Cliente): comprar como invitado no exige cuenta. La cuenta es opcional y
// se vincula 1:1 con el cliente; el email sigue viviendo solo en `clientes`.
// Nunca se guarda la contraseña en claro, solo su hash scrypt.
model Cuenta {
  id           Int      @id @default(autoincrement())
  clienteId    Int      @unique
  cliente      Cliente  @relation(fields: [clienteId], references: [id])
  passwordHash String
  creadaEn     DateTime @default(now())

  @@map("cuentas")
}

// Operadores del panel. A diferencia de los clientes, no hay registro
// público: el administrador de demo se crea con un script (ver README).
model Administrador {
  id           Int      @id @default(autoincrement())
  usuario      String   @unique
  nombre       String?
  passwordHash String
  creadoEn     DateTime @default(now())

  @@map("administradores")
}

// Tabla de referencia con los estados del flujo de un pedido (la "cola").
// Evita guardar el estado como texto libre en cada fila de pedidos: un typo ya
// no puede inventar un estado y renombrar uno es un solo UPDATE. `orden` fija
// la secuencia del flujo.
model EstadoPedido {
  id        Int               @id @default(autoincrement())
  codigo    String            @unique
  nombre    String
  orden     Int
  pedidos   Pedido[]
  historial PedidoHistorial[]

  @@map("estados_pedido")
}

// El pedido NO guarda un total denormalizado: el total real vive en Factura,
// calculado a partir del detalle. Esto evita datos derivados desincronizados.
// Tampoco guarda su posición en la cola: sale de `fecha` (FIFO entre los
// pendientes), en vez de una columna extra que habría que mantener al día.
model Pedido {
  id        Int               @id @default(autoincrement())
  clienteId Int
  cliente   Cliente           @relation(fields: [clienteId], references: [id])
  fecha     DateTime          @default(now())
  estadoId  Int
  estado    EstadoPedido      @relation(fields: [estadoId], references: [id])
  detalles  DetallePedido[]
  factura   Factura?
  historial PedidoHistorial[]

  @@map("pedidos")
}

// Bitácora de transiciones: una fila por cambio de estado (relación 1:N con
// Pedido). El estado actual vive en Pedido; el historial no se pierde.
model PedidoHistorial {
  id       Int          @id @default(autoincrement())
  pedidoId Int
  pedido   Pedido       @relation(fields: [pedidoId], references: [id])
  estadoId Int
  estado   EstadoPedido @relation(fields: [estadoId], references: [id])
  fecha    DateTime     @default(now())

  @@map("pedido_historial")
}

// Entidad asociativa que resuelve la relación N:M entre Pedido y Galleta.
// precioUnitario es una "foto" del precio al momento de la venta: si la
// galleta cambia de precio después, esta factura histórica no se altera.
model DetallePedido {
  id             Int     @id @default(autoincrement())
  pedidoId       Int
  pedido         Pedido  @relation(fields: [pedidoId], references: [id])
  galletaId      Int
  galleta        Galleta @relation(fields: [galletaId], references: [id])
  cantidad       Int
  precioUnitario Float

  @@map("detalle_pedido")
}

// Documento fiscal separado del pedido comercial (relación 1:1 vía
// pedidoId @unique). Modela que "pedido" y "factura" son conceptos distintos.
model Factura {
  id           Int      @id @default(autoincrement())
  pedidoId     Int      @unique
  pedido       Pedido   @relation(fields: [pedidoId], references: [id])
  numero       String   @unique
  fechaEmision DateTime @default(now())
  subtotal     Float
  impuesto     Float
  total        Float

  @@map("facturas")
}
