# Copia este archivo a backend/.env (o ejecuta `npm run env:init` en la raíz).
# La ruta de SQLite es relativa a la carpeta backend/prisma/.
DATABASE_URL="file:./dev.db"
PORT=4001

# Firma de los tokens de sesión (cookies HttpOnly). En producción usa un valor
# largo y aleatorio; el valor por defecto solo sirve para la demo local.
SESSION_SECRET="cambia-esto-en-produccion"

# Administrador de demo (SOLO PARA DEMO). Se crea/actualiza con:
#   npm run admin:crear
# El script no borra datos. No hay registro público de administradores.
ADMIN_USUARIO=demo
ADMIN_PASSWORD=demo1234
ADMIN_NOMBRE="Administrador de demo"
